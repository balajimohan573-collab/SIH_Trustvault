# Copy to .env (same folder) for `docker compose up`.
# These MUST be changed in any real deployment. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace-with-a-long-random-secret
TRUSTVAULT_MASTER_KEY=replace-with-a-long-random-master-key
TRUSTVAULT_ADMIN_PASSWORD=replace-with-a-strong-admin-password